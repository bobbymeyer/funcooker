<%= page_head "shopping", lede: "For the #{pluralize(@shopping_list.entries.size, "meal")} planned in the next #{pluralize(@shopping_list.days, "day")}, less what is in stock." %>

<%= form_with url: shopping_list_path, method: :get, class: "form form--inline" do |form| %>
  <div class="field field--inline">
    <%= form.label :days, "Days ahead" %>
    <%= form.number_field :days, value: @shopping_list.days, min: 1, max: 28 %>
  </div>
  <%= form.submit "Look ahead", class: "button button--quiet", name: nil %>
<% end %>

<% if @shopping_list.items.any? %>
  <div data-controller="copy">
    <textarea class="visually-hidden" data-copy-target="source" readonly aria-label="The list, one item per line"><%= @shopping_list.to_text %></textarea>
    <div class="run">
      <% if Reminders.available? %>
        <%= button_to "Send to Reminders", remind_shopping_list_path(days: @shopping_list.days), class: "button button--primary" %>
      <% end %>
      <button type="button" class="button<%= " button--primary" unless Reminders.available? %>" data-action="copy#copy" data-copy-target="button">Copy for Reminders</button>
      <%= link_to "Plain text", shopping_list_path(format: :text, days: @shopping_list.days), class: "link-quiet" %>
      <%= link_to "JSON for Shortcuts", shopping_list_path(format: :json, days: @shopping_list.days), class: "link-quiet" %>
    </div>
    <p class="hint">
      <% if Reminders.available? %>
        Send adds each item to <%= Reminders.list_name %> on this Mac, skipping any already there and not ticked. Or paste the copy into any Reminders list: each line becomes a reminder.
      <% else %>
        Paste into a Reminders list: each line becomes a reminder, and a Groceries list sorts them into sections. Sending straight to Reminders needs the app running on the Mac itself, not in a container.
      <% end %>
    </p>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th scope="col">Buy</th>
        <th scope="col" class="numeric">Need</th>
        <th scope="col" class="numeric">Have</th>
        <th scope="col">For</th>
      </tr>
    </thead>
    <tbody>
      <% @shopping_list.items.each do |item| %>
        <tr>
          <td><%= item.title %><% if item.note %><br><small><%= item.note %></small><% end %></td>
          <td class="numeric"><%= "#{quantity(item.needed)} #{item.unit}" unless item.to_taste %></td>
          <td class="numeric"><%= "#{quantity(item.on_hand)} #{item.unit}" unless item.to_taste %></td>
          <td><%= item.meals.map { |entry| entry.dish.name }.uniq.to_sentence %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty"><%= @shopping_list.entries.any? ? "Everything the planned meals need is in stock." : "Nothing planned. Plan some meals on the schedule." %></p>
<% end %>

<%= explain label: "Send it to Reminders from the Mac, on a schedule" do %>
  <p>However the app is hosted, the Mac can pull the list itself. In the funcooker checkout:</p>
  <pre><code>osascript -l JavaScript lib/reminders/add.js <%= shopping_list_url(format: :json) %></code></pre>
  <p>Run it from a LaunchAgent to keep Groceries current. It adds only what is not already on the list.</p>
<% end %>

<%= explain label: "Send it to Reminders with a Shortcut" do %>
  <p>Build this once in the Shortcuts app. It adds each item to Groceries, skipping any already there and not yet ticked.</p>
  <ol class="numbered">
    <li><strong>Get Contents of URL</strong>: <code><%= shopping_list_url(format: :json) %></code></li>
    <li><strong>Get Dictionary Value</strong> for <code>items</code></li>
    <li><strong>Repeat with Each</strong> item:
      <ol class="numbered">
        <li><strong>Get Dictionary Value</strong> for <code>title</code> in Repeat Item</li>
        <li><strong>Find Reminders</strong> where List is Groceries, Title is the value, and Is Not Completed</li>
        <li><strong>If</strong> Reminders has no value: <strong>Add New Reminder</strong> with the title, in Groceries, with Notes from <code>notes</code></li>
      </ol>
    </li>
  </ol>
  <p>Add <code>?days=3</code> to the URL to shop for fewer days.</p>
<% end %>
