<%= page_head "stock", lede: "First out first: what expires soonest is used before the rest." do %>
  <%= link_to "Add a receipt", new_receipt_path, class: "button button--primary" %>
  <%= link_to "Add by hand", new_stock_item_path, class: "button" %>
<% end %>

<% use_first, rest = @stock_items.partition { |item| item.expires_on && item.expires_on <= Date.current + StockItemsController::USE_FIRST_DAYS } %>

<% if use_first.any? %>
  <h2>use first</h2>
  <%= render "stock_items/table", items: use_first %>
<% end %>

<% if rest.any? %>
  <h2><%= use_first.any? ? "then" : "on hand" %></h2>
  <%= render "stock_items/table", items: rest %>
<% end %>

<% if @stock_items.empty? %>
  <p class="empty">Nothing in stock.</p>
<% end %>
