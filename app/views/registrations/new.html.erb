<%= page_head "make an account" %>
<%= its_swiss_form_with model: @user, url: registration_path, class: "form measure" do |form| %>
  <%= render "its_swiss/shared/errors", record: @user %>
  <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", label: "Email address" %>
  <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, hint: "At least 10 characters." %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  <%= form.submit "Make the account" %>
<% end %>
