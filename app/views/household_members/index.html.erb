<%= page_head "household", lede: "Everyone at a meal must be able to eat it. Portions scale recipes, which are stored for one adult." do %>
  <%= link_to "Add someone", new_household_member_path, class: "button button--primary" %>
<% end %>

<% if @household_members.any? %>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col" class="numeric">Portion</th>
        <th scope="col">By default</th>
        <th scope="col">Can't eat</th>
        <th scope="col">Likes</th>
        <th scope="col">Dislikes</th>
        <th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @household_members.each do |member| %>
        <% needs = member.food_needs %>
        <tr>
          <td><%= member.name %></td>
          <td class="numeric"><%= quantity(member.portion) %></td>
          <td><%= member.eats_by_default? ? "yes" : "no" %></td>
          <td><%= needs.select(&:restriction?).map { |need| need.subject.name }.sort.join(", ") %></td>
          <td><%= needs.select { |need| need.preference? && need.likes? }.map { |need| need.subject.name }.sort.join(", ") %></td>
          <td><%= needs.select { |need| need.preference? && need.dislikes? }.map { |need| need.subject.name }.sort.join(", ") %></td>
          <td class="run">
            <%= link_to "Edit", edit_household_member_path(member), class: "link-quiet" %>
            <%= delete_button household_member_path(member), quiet: true, confirm: "Remove #{member.name} and their food needs?" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">Nobody yet. Recipes are stored for one adult; the household is who the plan is for.</p>
<% end %>

<h2>settings</h2>
<%= its_swiss_form_with model: Household.current, url: household_path, method: :patch, class: "form form--dense measure" do |form| %>
  <%= form.select :time_zone, Household.time_zone_options, {}, hint: "What today and this evening mean: when meals fall, and when thaws are due." %>
  <%= form.select :thaw_reminder_hour, (0..23).map { |hour| [ Time.current.change(hour:).strftime("%-l %p").downcase, hour ] }, {},
        label: "Send thaw reminders at", hint: "Each day, the app sends that evening's thaws to Reminders, when it runs on the Mac." %>
  <%= form.select :prep_day_starts, (0..23).map { |hour| [ Time.current.change(hour:).strftime("%-l %p").downcase, hour ] }, {}, label: "Prep from" %>
  <%= form.select :prep_day_ends, (1..24).map { |hour| [ hour == 24 ? "midnight" : Time.current.change(hour:).strftime("%-l %p").downcase, hour ] }, {},
        label: "Prep until", hint: "Free time for prep is looked for between these hours." %>
  <%= form.text_field :busy_calendars, label: "Busy calendars", hint: "The Mac calendars whose events count as busy, by name, separated by commas. Blank: all of them." %>
  <%= form.text_field :prep_calendar, label: "Prep calendar", hint: "The Mac calendar booked prep goes on. Blank: the default calendar." %>
  <%= form.submit "Save" %>
<% end %>
