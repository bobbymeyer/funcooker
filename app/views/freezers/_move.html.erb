<%= form_with url: path, class: "move" do |form| %>
  <%= form.number_field :servings, value: quantity(lot.quantity), step: "any", min: 0, max: lot.quantity, "aria-label": "#{lot.unit.presence || "Quantity"} of #{lot.stockable.name} to #{label.downcase}" %>
  <%= form.submit label, class: "button button--quiet", name: nil %>
<% end %>
