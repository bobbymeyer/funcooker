<%= page_head "imports" do %>
  <%= link_to "Import a recipe", new_recipe_import_path, class: "button button--primary" %>
<% end %>

<% if @recipe_imports.any? %>
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Added</th>
        <th scope="col">From</th>
        <th scope="col">Status</th>
        <th scope="col">Recipe</th>
        <th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @recipe_imports.each do |import| %>
        <tr>
          <td><%= link_to l(import.created_at.to_date, format: :long), import %></td>
          <td><%= import.source_url || import.dish_name || "pasted text" %></td>
          <td><%= import.status %></td>
          <td><%= link_to import.component.name, import.component if import.component %></td>
          <td><%= delete_button recipe_import_path(import), quiet: true, confirm: "Delete this import? The recipe it made is kept." %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No imports yet.</p>
<% end %>
