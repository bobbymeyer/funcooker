<%= turbo_stream_from @recipe_import %>

<%= page_head "import", lede: import_source(@recipe_import) %>

<% if @recipe_import.failed? %>
  <p class="errors"><%= @recipe_import.error %></p>
  <p><%= link_to "Try again", new_recipe_import_path %></p>
<% else %>
  <p class="empty">Importing. This page updates when it is done.</p>
<% end %>
